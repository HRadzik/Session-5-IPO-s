#input phase
principle = float(input("Enter principle amount: "))
years = int(input("Enter years to maturity: "))
#processing phase
if principle > 100000:
  if years == 5: rate = 0.06
  else:
      rate = 0.02
else:
  if 50000 <= principle <= 100000:
      if years == 10: rate = 0.05
      elif years == 5: rate = 0.04
      else:
          rate = 0.02
  else:
      rate = 0.02
interest = principle * rate
#output phase
print("Principle: $", round(principle, 2))
print("Interest Rate:", rate * 100, "%")
print("First Year Interest: $", round(interest, 2))
